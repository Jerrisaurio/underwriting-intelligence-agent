# Copy to .env and fill in. Never commit .env.

# Directory holding portfolio_mexico.csv, claims.csv and watchlist.csv
UW_DATA_DIR=data
# Reference date for "active policy", claim ageing, etc. (YYYY-MM-DD). Defaults to today.
UW_AS_OF_DATE=

# --- Web research (optional). Without key AND model the agent runs on internal data only.
OPENAI_API_KEY=
# A model available in your account that supports the Responses API web_search tool.
# gpt-5.4-mini was chosen with measured data (eval/REPORT.md §5); gpt-4o-mini is cheaper but
# verified only 46% of real companies.
UW_OPENAI_MODEL=gpt-5.4-mini
UW_REQUEST_TIMEOUT_S=60

# Prices in USD, from your contract / the provider's pricing page. Leave empty to report
# token counts without cost (cost is never guessed).
UW_PRICE_INPUT_PER_MTOK=
UW_PRICE_OUTPUT_PER_MTOK=
UW_PRICE_PER_WEB_SEARCH=

# --- Cache of web research results
UW_CACHE_DIR=.cache
UW_CACHE_TTL_DAYS=7
